{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "npm: dev",
      "detail": "Starts the Vite development server with hot module reload",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite v.*$",
          "endsPattern": "^.*ready in.*$"
        }
      }
    },
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "detail": "Builds the production bundle into dist/",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "preview",
      "label": "npm: preview",
      "detail": "Locally preview the built production bundle in dist/",
      "problemMatcher": []
    }
  ]
}
